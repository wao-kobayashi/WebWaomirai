//
doctype html
html(lang="jp")
  head
    heads
      title WAO未来塾関連のページ一覧
      link(href="../static/css/application.css?undefined", rel="stylesheet")
      meta(name="viewport", content="width=device-width, initial-scale=1,minimum-scale=1.0, maximum-scale=1.0, user-scalable=no")
      meta(charset="UTF-8")
      meta(name="robots", content="noindex,nofollow")
      meta(name="apple-mobile-web-app-capable", content="yes")
      meta(name="apple-mobile-web-app-status-bar-style", content="black-translucent")
      script(src="https://cdnjs.cloudflare.com/ajax/libs/jQuery-rwdImageMaps/1.6/jquery.rwdImageMaps.min.js")
      style.
        .page-list-wrapper {
          width: 70%;
          margin: 30px auto;
          padding: 40px 20px 60px;
          box-shadow: 0 5px 10px #ccc;
        }
        .page-list ul { margin-left: 0.2em;  }
        .page-list li { line-height: 1.6; list-style:disc; }
        .page-list > li { margin-bottom:20px; }
        .page-list-note { color:#999; font-size:80%; margin:0 0 12px !important; }
        .page-list-unset { color:#c33; font-size:70%; margin-left:0.5em; }
        .page-list-sub { margin-top:10px; }
  body
    //- ページ一覧は src/pug/pages 配下から自動生成（.eleventy.js → src/pug/pageList/pageGroups.js）
    //- 見出し・メモなどの表示は src/pug/pageList/pageMeta.js で設定
    .page-list-wrapper
      ul.page-list
        each group in pageGroups(collections.all)
          li
            - var single = group.subs.length === 1 && group.subs[0].pages.length === 1
            if single
              a(href=group.subs[0].pages[0].url)= group.label
            else
              = group.label
            if !group.labeled
              span.page-list-unset ラベル未設定（pageMeta.js）
            if group.note || (!group.labeled && group.metaTitle)
              p.page-list-note= group.note || group.metaTitle
            if !single
              ul
                each sub in group.subs
                  if !sub.label
                    each p in sub.pages
                      li: a(href=p.url)= p.label
                  else if sub.pages.length === 1
                    li: a(href=sub.pages[0].url)= sub.label
                  else
                    li.page-list-sub= sub.label
                      ul
                        each p in sub.pages
                          li: a(href=p.url)= p.label
