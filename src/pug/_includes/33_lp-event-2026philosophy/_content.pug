    - const cssLocal = loycus ? '../' : ''

    link(href=`${cssLocal}33_lp-event-2026philosophy.css?v=${Date.now()}`, rel="stylesheet")

    meta(property="description", content=baseDescription)
    meta(property="og:image", content=ImgOgp)
    meta(property="og:description", content=baseDescription)
