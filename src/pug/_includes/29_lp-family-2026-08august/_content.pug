//mixin
include _mixin  
//variable
include _variables 
//授業データ
include _format

doctype html
html
  head
    meta(charset="utf-8")
    script.
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-W3X8CG9C');
    // End Google Tag Manager
    meta(http-equiv="Content-Type", content="text/html; charset=utf-8")
    meta(name="viewport", content="width=device-width,initial-scale=1")
    link(href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css", rel="stylesheet")
    - const cssBase = loycus ? '../../../css/' : '../../css/'
    - const cssLocal = loycus ? '../' : ''

    link(href=`${cssBase}29_lp-family-2026-08august.css?v=${Date.now()}`, rel="stylesheet")
    link(href=`${cssLocal}29_lp-family-2026-08august.css?v=${Date.now()}`, rel="stylesheet")

    meta(property="og:image", content=ImgOgp)
    title 【ワオ未来塾】親子で参加♪授業体験＆説明会｜#{lessondate}
    script(src="https://waomirai.com/lp/assets/commonjs/jquery_3.7.1.js")
    script(src="https://waomirai.com/lp/assets/commonjs/qrcode.min.js")
    script(src="https://waomirai.com/lp/assets/commonjs/jquery.inview.min.js")
  body
    //01メインビジュアル(PC)
    //2026aprilの時は少しスタイル変える
    header
      img(src='https://waomirai.com/lp/assets/commonimages/logo.svg')
    //26年3月末イベント用のヘッダ
    .lp-family-fvsp-2608august 
        .slider
          .slider-content  
            +BannerSlider2608-August 
        .fvlogo
          img(src=ImgFvText)

        .fvinfo 
          .fvinfo-title.first 
              |期間
          .fvinfo-content.first
             =lessondate
          .fvinfo-title 
              |対象
          .fvinfo-content 
              |新小学3年生以上とその保護者
        .fvtext 
                |親子で楽しめるワオ未来塾の
                br
                |“考える力”の体験授業。
                br
                br
                |哲学で問いを深め、科学で世界を探り、
                br
                |経済で社会をひもとく。
                br
                br
                |未来を生きる力を
                br
                |一緒に体感してみませんか？
            
    .lp-family-fvpc-2608august
        .lp-family-fvpc-wrapper
            .lp-family-fvpc-left
                  .fvlogo
                    img(src=ImgFvText)
                  .fvinfo 
                    .fvinfo-title.first 
                        |期間
                    .fvinfo-content.first
                      =lessondate
                    .fvinfo-title 
                        |対象
                    .fvinfo-content 
                        |新小学3年生以上とその保護者
            .lp-family-fvpc-right
                .slider
                    .slider-content
                      +BannerSlider2608-August

    //02 目次
    section.lp-family-eventtoc
      .lp-family-eventtoc-list
        a.lp-family-eventtoc-item.economy(href="#event01")
          .lp-family-eventtoc-item-img
            img(src=ImgThumbSmallEc)
          .lp-family-eventtoc-item-body
            .lp-family-eventtoc-item-body-title
              |モノの値段はどう決まる? (経済)
            .lp-family-eventtoc-item-body-date
              |8/27(水) 19:30-20:15
          .lp-family-eventtoc-item-icon
            i.fa-solid.fa-chevron-down
        a.lp-family-eventtoc-item.science(href="#event02")
          .lp-family-eventtoc-item-img
            img(src=ImgThumbSmallSc)
          .lp-family-eventtoc-item-body
            .lp-family-eventtoc-item-body-title
              |太陽はなくなるとどうなる？(科学)
            .lp-family-eventtoc-item-body-date
              |8/28(金) 19:30-20:15
          .lp-family-eventtoc-item-icon
            i.fa-solid.fa-chevron-down

    //03 イベントの詳細（events をループ）
    each event in events
      section.lp-family-eventdetail(class=event.id)
        .lp-family-eventdetail-content.inview-hide.inview-triger(class=event.id, id=event.anchorId)
          // 上部エリア（画像・基本情報）
          .lp-family-eventdetail-content-top
            // 左側：サムネイル画像（PC表示のみ）
            .lp-family-eventdetail-content-top-left.pcimage
              .lp-family-eventdetail-content-top-left-img
                img(src=event.thumbnail)

            // 右側：詳細情報
            .lp-family-eventdetail-content-top-right
              // カテゴリー表示
              .lp-family-eventdetail-content-top-right-category
                // 科目ラベル（詳細版）
                .lp-family-eventdetail-content-top-right-category-child.subject
                  = event.subject
                // 対象学年ラベル（詳細版）
                .lp-family-eventdetail-content-top-right-category-child.target
                  = event.target

              // イベントタイトル
              .lp-family-eventdetail-content-top-right-title
                = event.title

              // サムネイル画像（SP表示のみ）
              .lp-family-eventdetail-content-top-right-img.spimage
                img(src=event.thumbnail)

              // 日時情報
              .lp-family-eventdetail-content-top-right-datetime
                // 日付（完全形式）
                .lp-family-eventdetail-content-top-right-datetime-date
                  = event.date
                // 時計アイコン
                .lp-family-eventdetail-content-top-right-datetime-icon
                  img(src=ImgIcnClock)
                // 時刻
                .lp-family-eventdetail-content-top-right-datetime-time
                  = event.time

              // イベント説明文
              .lp-family-eventdetail-content-top-right-text
                = event.description
                if event.note
                  p.lp-family-eventdetail-content-top-right-text-note
                    = event.note

              // こんな子におすすめ
              if event.recommend && event.recommend.length
                .lp-family-eventdetail-content-recommend
                  .lp-family-eventdetail-content-recommend-title
                    |こんな子におすすめ
                  ul.lp-family-eventdetail-content-recommend-list
                    each item in event.recommend
                      li= item

              // 担当講師
              .lp-family-eventdetail-content-teacher
                .lp-family-eventdetail-content-teacher-title
                  |担当講師
                .lp-family-eventdetail-content-teacher-body
                  .lp-family-eventdetail-content-teacher-body-img
                    img(src=event.teacherImg)
                  .lp-family-eventdetail-content-teacher-body-info
                    .lp-family-eventdetail-content-teacher-body-info-name
                      = event.teacherName
                    .lp-family-eventdetail-content-teacher-body-info-comment
                      = event.teacherComment

              // CTAボタン
              .lp-family-eventdetail-content-cta
                +btn-cta


    .join-faq
      // かんたん5STEP
      .join-5steps
          h2.join-5steps-title
            |かんたん5STEPで
            br.u-br-sp
            |参加可能
          .join-5steps-list
            //step1
            .join-5steps-box
                .join-5steps-box-head
                  p.join-5steps-box-head-step
                      |STEP
                      span|1
                  .join-5steps-box-head-img
                      img(src=ImgIcnStep01)
                h3.join-5steps-box-title
                      |LINEで公式アカウントを
                      br
                      |友だち追加
                p.join-5steps-box-text
                      span.spimage|まず公式アカウントを友だちに追加してください。
                      span.pcimage|まず、二次元コードからスマートフォンで公式アカウントを友だちに追加してください。
                      |・友だち追加は
                      +conditionalLink
                        |こちら
                      |から
                      br
                p(style='margin:20px auto 0; width: calc(100% - 40px); color:#999999 !important; font-size:87%;')
                        |LINEの友達追加等でお困りのことがございましたら下記までお問い合わせください。
                        br
                        a(href="mailto:mirai-waoug@waomirai.com" style="color:#999999 !important;")
                          |mirai-waoug@waomirai.com
            //step2
            .join-5steps-box
                .join-5steps-box-head
                  p.join-5steps-box-head-step
                      |STEP
                      span|2
                  .join-5steps-box-head-img
                      img(src=ImgIcnStep02)
                h3.join-5steps-box-title
                      |友だち登録後、LINEのトーク
                      br
                      |画面に送られる申し込み
                      br
                      |フォームをタップ！
            //step3
            .join-5steps-box
                .join-5steps-box-head
                  p.join-5steps-box-head-step
                      |STEP
                      span|3
                  .join-5steps-box-head-img
                      img(src=ImgIcnStep03)
                h3.join-5steps-box-title
                  |Zoomをインストール
                p.join-5steps-box-text
                  |お手持ちの端末にZoomのインストールをお願いします。パソコンまたはタブレットが推奨です
            //step4
            .join-5steps-box
                .join-5steps-box-head
                  p.join-5steps-box-head-step
                      |STEP
                      span|4
                  .join-5steps-box-head-img.step4
                    img(src=ImgIcnStep04)
                h3.join-5steps-box-title
                      |イベント前日に
                      br
                      |LINEメッセージで
                      br
                      |イベントURLをお送りします
            //step5
            .join-5steps-box
              .join-5steps-box-head
                p.join-5steps-box-head-step
                    |STEP
                    span|5
                .join-5steps-box-head-img
                  img(src=ImgIcnStep05)
              h3.join-5steps-box-title
                    |開催時間になったら
                    br
                    |届いたイベントURLから
                    br
                    |参加しましょう！
      // よくある質問
      .faq
        h2.faq-title
          |よくある質問
        .faq-content
            .faq-content-question
              p.faq-content-question-left|Q
              p.faq-content-question-right
                |カメラオンで参加は必要ですか？？
            .faq-content-answer
              p.faq-content-answer-left|A
              p.faq-content-answer-right
                |授業の双方向性を高めるため、原則としてカメラはオンにしてご参加をお願いしています。難しい場合はオフでも構いません。
                br
                |※受講者の映像は講師のみに表示され、他の受講者には表示されません。
        .faq-content
            .faq-content-question
              p.faq-content-question-left|Q
              p.faq-content-question-right
                |当日参加できなかった場合、後日アーカイブ視聴はできますか？
            .faq-content-answer
              p.faq-content-answer-left|A
              p.faq-content-answer-right
                |ご視聴いただけます。数日間は視聴可能とする予定です。
    .wao-content
      // ワオ未来塾って？
      .about-wao
        h2.about-wao-title
          |ワオ未来塾って？
        .about-wao-img
          img(src=ImgLogoWao)
        p.about-wao-text
            |全国で能開センターや個別指導Axisを展開、知育アプリ『ワオっち！』も手がける株式会社ワオ・コーポレーションがお送りする新しい学びの場「ワオ未来塾」。
            br
            br
            |21世紀に入ってから、テクノロジーやAIの進化により世界・社会は大きな変化を遂げようとしています。この変化の時代を生きる子どもたちには、柔軟な思考力と判断力、どんな状況にも揺るがない"自分の軸"が求められていきます。
            br
            br
            |半世紀にわたり子どもたちの教育に携わってきた当社は、こうした考えのもと、社会で活躍できる力を育む新しい学びの場、「ワオ未来塾」を開校いたします。
      // 授業の特長
      .about-feature
        h2.about-feature-title
          |授業の特長
        .about-feature-point
            i.fa-solid.fa-earth-americas
            p.about-feature-point-text
              |オンライン授業で
              br.u-br-sp
              |全国どこからでも参加OK
        .about-feature-point
            i.fa-regular.fa-comments
            p.about-feature-point-text
              |ライブだからチャットで
              br.u-br-sp
              |授業に参加できる!
        .about-feature-point
            i.fa-solid.fa-laptop
            p.about-feature-point-text
              |必要なのは
              br.u-br-sp
              |PCかタブレットだけ！
      // ワオ未来塾
      .about-school
        h2.about-school-catch
            |社会で役立つ学びを、オンラインで今始めよう
        .about-school-logo
            img(src='https://waomirai.com/lp/assets/commonimages/logo.svg')
        p.about-school-target
            |〈対象〉小学3〜6年生／中学生／高校生
        .about-school-4subjects
            img(src=Img4subject)
        .about-school-feature
          .about-school-feature-box
            .about-school-feature-box-title
              .about-school-feature-box-title-icon
                  img(src='https://waomirai.com/lp/assets/lpimages/07_event-lp-2025feb/icn_subject.png')
              h3.about-school-feature-box-title-text
                  |新しい学び
            p.about-school-feature-box-text
                |これから必要になる自己肯定感を養う「哲学」、正しく物事目を育む「科学」、社会を支える仕組みを学ぶ「経済」、世界共通言語の「英語」を身につけます。
          .about-school-feature-box
            .about-school-feature-box-title
              .about-school-feature-box-title-icon
                  img(src='https://waomirai.com/lp/assets/lpimages/07_event-lp-2025feb/icn_subject.png')
              h3.about-school-feature-box-title-text
                  |飛び級制
            p.about-school-feature-box-text
                |授業は推奨学年を設定していますが、理解度に応じて高いレベルの授業を選ぶことができます。 そのため学年に縛られず、自由なペースで学びを深めることができます。
          .about-school-feature-box
            .about-school-feature-box-title
              .about-school-feature-box-title-icon
                  img(src='https://waomirai.com/lp/assets/lpimages/07_event-lp-2025feb/icn_subject.png')
              h3.about-school-feature-box-title-text
                  |オンラインライブ授業
            p.about-school-feature-box-text
                |授業はライブ形式で行われ、チャットやリアクションボタンで積極的に授業に参加できます。自分の意見が授業で取り上げられることも！
        .about-school-btn
            a(href='https://waomirai.com/', target='_blank')
              .about-school-btn-text
                |ワオ未来塾の公式サイトへ
              .about-school-btn-icn
                img(src='https://waomirai.com/lp/assets/lpimages/07_event-lp-2025feb/icn_target.svg')

