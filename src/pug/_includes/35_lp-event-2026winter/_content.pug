//mixin
include _mixin  
//variable
include _variables 
//data
include _data
doctype html
html
  head
    meta(charset="utf-8")
    script.
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-W3X8CG9C');
    // End Google Tag Manager
    meta(http-equiv="Content-Type", content="text/html; charset=utf-8")
    meta(name="viewport", content="width=device-width,initial-scale=1")
    link(href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css", rel="stylesheet")
    link(href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined", rel="stylesheet")
    - const cssLocal = loycus ? '../' : ''
    link(href=`${cssLocal}35_lp-event-2026winter.css?v=${Date.now()}`, rel="stylesheet")

    meta(property="og:image", content=ImgOgp)
    title #{MetaTitle}
    script(src="https://waomirai.com/lp/assets/commonjs/jquery_3.7.1.js")
    script(src="https://waomirai.com/lp/assets/commonjs/qrcode.min.js")
    script(src="https://waomirai.com/lp/assets/commonjs/jquery.inview.min.js")
  body
    //- PC左カラム（ロゴ）
    .pc-left
      .pc-left-logo
        img(src='https://waomirai.com/lp/assets/commonimages/logo.svg', alt='ワオ未来塾')
      .pc-left-cta
        +btn-line

    //- メインコンテンツ（スマホファースト）
    .main-content
      //- ヘッダー（PC左カラム非表示時のみ表示）
      header.lp-header
        img(src='https://waomirai.com/lp/assets/commonimages/logo.svg', alt='ワオ未来塾')

      //- 01 FV
      section.lp-fv
        h1.lp-fv-img
          img(src=ImgFv, alt='身近な「なんで？」を考えることが楽しくなる！冬の探究学習イベント 2026-2027')
        .lp-fv-info
          dl.lp-fv-info-row
            dt.lp-fv-info-head 日時
            dd.lp-fv-info-cell
              |12/21(月)・12/22(火)・12/23(水)
              br
              |1/7(木)・1/8(金)
          dl.lp-fv-info-row
            dt.lp-fv-info-head 費用
            dd.lp-fv-info-cell.is-price 無料
          dl.lp-fv-info-row
            dt.lp-fv-info-head 対象
            dd.lp-fv-info-cell
              |小学3〜6年生、中学1〜3年生
              br
              |(保護者の方のご見学も大歓迎です)
          dl.lp-fv-info-row
            dt.lp-fv-info-head 場所
            dd.lp-fv-info-cell Zoomウェビナー(オンライン)
        .lp-fv-cta
          +btn-line
        .lp-fv-intro
          p 「ロウソクの火の謎」や「1000円で選ぶ最高のプレゼント」など、子どもたちの「なんで？」をきっかけに考える力を育てるオンラインイベントです。
          p 親子で楽しみながら、探究学習の第一歩を体験できます

      //- 02 イベント一覧
      section.lp-eventlist
        h2.lp-eventlist-title
          img(src=ImgEventList, alt='イベント一覧 ※複数イベント申し込み可能です')
        ul.lp-eventlist-grid
          each item in program
            li.lp-eventlist-item(class=`is-${item.category}`)
              .lp-eventlist-item-img
                img(src=item.thumb_s, alt='')
              .lp-eventlist-item-tags
                span.lp-eventlist-item-tag.is-subject= subjectLabels[item.category]
                span.lp-eventlist-item-tag.is-target= item.list_target
              p.lp-eventlist-item-title
                each line, i in item.list_title
                  if i > 0
                    br
                  | #{line}
              p.lp-eventlist-item-date= item.list_date
              a.lp-eventlist-item-link(href=`#${item.link}`)
                i.fa-solid.fa-chevron-down
                span 詳細を見る

      //- 03 イベント詳細
      section.lp-eventdetail
        each item in program
          article.lp-eventdetail-item(class=`is-${item.category}`, id=item.link)
            p.lp-eventdetail-item-tab= item.head_tag
            .lp-eventdetail-item-box
              h3.lp-eventdetail-item-title
                each line, i in item.title
                  if i > 0
                    br
                  | #{line}
              .lp-eventdetail-item-img
                img(src=item.thumb, alt='')
              dl.lp-eventdetail-item-info
                .lp-eventdetail-item-info-row
                  dt 日時
                  dd
                    span.lp-eventdetail-item-info-date= item.date
                    span.lp-eventdetail-item-info-time= item.time
                .lp-eventdetail-item-info-row
                  dt 対象
                  dd= item.target
              .lp-eventdetail-item-text
                each para in item.description
                  p= para

      //- 04 かんたん5STEPで参加可能（余白は 20_lp-parent-seminar-2026 基準）
      section.lp-steps
        h2.lp-section-title
          |かんたん5STEPで
          br
          |参加可能
        ol.lp-steps-list
          li.lp-steps-box
            .lp-steps-box-head
              .lp-steps-box-head-step
                |STEP
                span 1
              .lp-steps-box-head-img
                img(src=ImgIcnStep01, alt='')
            h3.lp-steps-box-title
              |LINEで公式アカウントを
              br
              |友だち追加
            .lp-steps-box-text
              p まず、スマートフォンで公式アカウントを友だちに追加してください。
              p
                |・友だち追加は
                +conditionalLink
                  |こちら
                |から
          li.lp-steps-box
            .lp-steps-box-head
              .lp-steps-box-head-step
                |STEP
                span 2
              .lp-steps-box-head-img
                img(src=ImgIcnStep02, alt='')
            h3.lp-steps-box-title
              |LINEのトーク画面に送られる
              br
              |申し込みフォームを
              br
              |タップして申込
          li.lp-steps-box
            .lp-steps-box-head
              .lp-steps-box-head-step
                |STEP
                span 3
              .lp-steps-box-head-img
                img(src=ImgIcnStep03, alt='')
            h3.lp-steps-box-title Zoomをインストール
            .lp-steps-box-text
              p お手持ちの端末にzoomのインストールをお願いします。パソコンまたはタブレットが推奨です
          li.lp-steps-box
            .lp-steps-box-head
              .lp-steps-box-head-step
                |STEP
                span 4
              .lp-steps-box-head-img
                img(src=ImgIcnStep04, alt='')
            h3.lp-steps-box-title
              |イベント当日に
              br
              |LINEメッセージで
              br
              |イベントURLをお送りします
          li.lp-steps-box
            .lp-steps-box-head
              .lp-steps-box-head-step
                |STEP
                span 5
              .lp-steps-box-head-img
                img(src=ImgIcnStep05, alt='')
            h3.lp-steps-box-title
              |開催時間になったら
              br
              |届いたイベントURLから
              br
              |参加しましょう！

      //- 05 よくある質問（余白は 20_lp-parent-seminar-2026 基準）
      section.lp-faq
        h2.lp-section-title よくある質問
        dl.lp-faq-item
          dt.lp-faq-q
            span.lp-faq-mark Q
            span.lp-faq-body 複数のテーマは申し込むことはできますか？
          dd.lp-faq-a
            span.lp-faq-mark A
            span.lp-faq-body 可能です。
        dl.lp-faq-item
          dt.lp-faq-q
            span.lp-faq-mark Q
            span.lp-faq-body カメラオンで参加は必要ですか？
          dd.lp-faq-a
            span.lp-faq-mark A
            span.lp-faq-body
              |授業の双方向性を高めるため、原則としてカメラはオンにしてご参加をお願いしています。
              br
              |難しい場合はオフでも構いません。
              br
              |※受講者の映像は講師のみに表示され、他の受講者には表示されません。
        dl.lp-faq-item
          dt.lp-faq-q
            span.lp-faq-mark Q
            span.lp-faq-body
              |当日参加できなかった場合、
              br
              |後日アーカイブ視聴はできますか？
          dd.lp-faq-a
            span.lp-faq-mark A
            span.lp-faq-body
              |ご視聴いただけます。
              br
              |数日間は視聴可能とする予定です。

      //- 06 ワオ未来塾について（余白は 33_lp-event-2026philosophy の SP 基準）
      section.lp-about
        .lp-about-wrapper
          h2.lp-about-title ワオ未来塾について
          .lp-about-logo
            img(src=ImgLogoWao, alt='教育を変える ワオ・コーポレーション')
          p.lp-about-text 全国で「能開センター」や「個別指導Axis」を展開する、株式会社ワオ・コーポレーションがお届けする新しいオンライン学習の場「ワオ未来塾」。
          p.lp-about-text 21世紀に入ってから、テクノロジーやAIの進化により世界・社会は大きな変化を遂げようとしています。この変化の時代を生きる子どもたちには、柔軟な思考力と判断力、どんな状況にも揺るがない"自分の軸"が求められていきます。
          p.lp-about-text 半世紀にわたり子どもたちの教育に携わってきた当社は、自分の頭で考える力を育む「哲学」をはじめ、「科学」「経済」など、これからの社会で活きる多様な学びを提供しています。
          a.lp-about-button(href='https://waomirai.com/', target='_blank', rel='noopener')
            span ワオ未来塾の公式サイトへ
            i.fa-solid.fa-arrow-up-right-from-square

      //- 07 フッター（余白は 33_lp-event-2026philosophy の SP 基準）
      footer.lp-footer
        .lp-footer-wrapper
          .lp-footer-logo
            img(src='https://waomirai.com/lp/assets/commonimages/logo_white.svg', alt='ワオ未来塾')
          ul.lp-footer-list
            li.lp-footer-item
              a.lp-footer-link(href='https://www.wao-corp.com/', target='_blank', rel='noopener')
                span 運営会社
                i.fa-solid.fa-arrow-up-right-from-square
            li.lp-footer-item
              a.lp-footer-link(href='https://www.wao-corp.com/privacy/', target='_blank', rel='noopener')
                span プライバシーポリシー
                i.fa-solid.fa-arrow-up-right-from-square
            li.lp-footer-item
              a.lp-footer-link(href='https://waomirai.com/commerce_law/', target='_blank', rel='noopener')
                span 特定商取引法
                i.fa-solid.fa-arrow-up-right-from-square
            li.lp-footer-item
              a.lp-footer-link(href='https://waomirai.com/terms/', target='_blank', rel='noopener')
                span 利用規約
                i.fa-solid.fa-arrow-up-right-from-square
          p.lp-footer-copy &copy; WAO CORPORATION

    //- PC右カラム（INDEX）
    .pc-right
      .pc-index
        .pc-index-title
          p.pc-index-title-eng INDEX
          p.pc-index-title-jpn オンライン授業一覧
        ol.pc-index-list
          each item in program
            li.pc-index-item
              a.pc-index-link(href=`#${item.link}`)
                span.pc-index-link-number #{item.item_number}
                span.pc-index-link-title #{item.menu_title}

//js
include _js
+modal
+fixed-btn