//mixin
include _mixin  
//variable
include _variables 
//data
include _data
doctype html
html
  head
    meta(charset="utf-8")
    script.
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-W3X8CG9C');
    // End Google Tag Manager
    meta(http-equiv="Content-Type", content="text/html; charset=utf-8")
    meta(name="viewport", content="width=device-width,initial-scale=1")
    link(href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css", rel="stylesheet")
    link(href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined", rel="stylesheet")
    - const cssLocal = loycus ? '../' : ''
    link(href=`${cssLocal}35_lp-event-2026winter.css?v=${Date.now()}`, rel="stylesheet")

    meta(property="og:image", content=ImgOgp)
    title #{MetaTitle}
    script(src="https://waomirai.com/lp/assets/commonjs/jquery_3.7.1.js")
    script(src="https://waomirai.com/lp/assets/commonjs/qrcode.min.js")
    script(src="https://waomirai.com/lp/assets/commonjs/jquery.inview.min.js")
  body
    //- PC左カラム（ロゴ）
    .pc-left
      .pc-left-logo
        img(src='https://waomirai.com/lp/assets/commonimages/logo.svg', alt='ワオ未来塾')

    //- メインコンテンツ（スマホファースト）
    .main-content
      //- ヘッダー（PC左カラム非表示時のみ表示）
      header.lp-header
        img(src='https://waomirai.com/lp/assets/commonimages/logo.svg', alt='ワオ未来塾')

      //- 01 FV
      section.lp-fv
        h1.lp-fv-img
          img(src=ImgFv, alt='身近な「なんで？」を考えることが楽しくなる！冬の探究学習イベント 2026-2027')
        .lp-fv-info
          dl.lp-fv-info-row
            dt.lp-fv-info-head 日時
            dd.lp-fv-info-cell
              |12/21(月)・12/22(火)・12/23(水)
              br
              |1/7(木)・1/8(金)
          dl.lp-fv-info-row
            dt.lp-fv-info-head 費用
            dd.lp-fv-info-cell.is-price 無料
          dl.lp-fv-info-row
            dt.lp-fv-info-head 対象
            dd.lp-fv-info-cell
              |小学3〜6年生、中学1〜3年生
              br
              |(保護者の方のご見学も大歓迎です)
          dl.lp-fv-info-row
            dt.lp-fv-info-head 場所
            dd.lp-fv-info-cell Zoomウェビナー(オンライン)
        .lp-fv-cta
          +conditionalLink('lp-btn-line')
            span.lp-btn-line-text LINEで無料申込
            span.lp-btn-line-icon
              i.fa-solid.fa-chevron-right
        .lp-fv-intro
          p 「ロウソクの火の謎」や「1000円で選ぶ最高のプレゼント」など、子どもたちの「なんで？」をきっかけに考える力を育てるオンラインイベントです。
          p 親子で楽しみながら、探究学習の第一歩を体験できます

      //- 02 イベント一覧
      section.lp-eventlist
        h2.lp-eventlist-title
          img(src=ImgEventList, alt='イベント一覧 ※複数イベント申し込み可能です')
        ul.lp-eventlist-grid
          each item in program
            li.lp-eventlist-item(class=`is-${item.category}`)
              .lp-eventlist-item-img
                img(src=item.thumb_s, alt='')
              .lp-eventlist-item-tags
                span.lp-eventlist-item-tag.is-subject= subjectLabels[item.category]
                span.lp-eventlist-item-tag.is-target= item.list_target
              p.lp-eventlist-item-title
                each line, i in item.list_title
                  if i > 0
                    br
                  | #{line}
              p.lp-eventlist-item-date= item.list_date
              a.lp-eventlist-item-link(href=`#${item.link}`)
                i.fa-solid.fa-chevron-down
                span 詳細を見る

      //- 03 イベント詳細
      section.lp-eventdetail
        each item in program
          article.lp-eventdetail-item(class=`is-${item.category}`, id=item.link)
            p.lp-eventdetail-item-tab= item.head_tag
            .lp-eventdetail-item-box
              h3.lp-eventdetail-item-title
                each line, i in item.title
                  if i > 0
                    br
                  | #{line}
              .lp-eventdetail-item-img
                img(src=item.thumb, alt='')
              dl.lp-eventdetail-item-info
                .lp-eventdetail-item-info-row
                  dt 日時
                  dd
                    span.lp-eventdetail-item-info-date= item.date
                    span.lp-eventdetail-item-info-time= item.time
                .lp-eventdetail-item-info-row
                  dt 対象
                  dd= item.target
              .lp-eventdetail-item-text
                each para in item.description
                  p= para

    //- PC右カラム（INDEX）
    .pc-right
      .pc-index
        .pc-index-title
          p.pc-index-title-eng INDEX
          p.pc-index-title-jpn オンライン授業一覧
        ol.pc-index-list
          each item in program
            li.pc-index-item
              a.pc-index-link(href=`#${item.link}`)
                span.pc-index-link-number #{item.item_number}
                span.pc-index-link-title #{item.menu_title}

//js
include _js
+modal
+fixed-btn