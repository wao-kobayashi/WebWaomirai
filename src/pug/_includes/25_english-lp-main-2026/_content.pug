              .englp-section-solution-grid-title-number|02
              .englp-section-solution-grid-title-title|トレーニング動画
          .englp-section-solution-grid-content.item-b
              .englp-section-solution-grid-content-left
                .englp-section-solution-grid-content-left-title 
