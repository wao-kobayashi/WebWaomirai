  body
    header
       h1.pcimage
          img(src=ImgHeadLogoPc)
       h1.spimage
           img(src=ImgHeadLogoSp)          
       .humberger
          img(src=ImgHumbgerMenu)
       nav
         +menu-links 
    main 
      .englp-fv 
        .englp-fv-text
          .englp-fv-subtitle.grid-a
           span
            |子どもオンライン英会話
          .englp-fv-title
            |お子様の
            br.spimage
            |英会話の
            br.pcimage
            |悩みを
            br.spimage
            |楽しく解決！
          .englp-fv-cta-wrap
            a(href=UrlCv, target='_blank').englp-fv-cta-button
              .englp-fv-cta-button-sub
                |無料期間中のみの受講もOK
              .englp-fv-cta-button-free
