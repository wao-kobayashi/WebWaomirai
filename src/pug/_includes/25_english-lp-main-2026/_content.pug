                img(src=ImgStructure03)
          .englp-section-solution-grid-title.item-c
              .englp-section-solution-grid-title-number| 
              .englp-section-solution-grid-title-title|
          .englp-section-solution-grid-content.englp-section-solution-grid-content03.item-d
              .englp-section-solution-grid-content-left
                .englp-section-solution-grid-content-left-title 
