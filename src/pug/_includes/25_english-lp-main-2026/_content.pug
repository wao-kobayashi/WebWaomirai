    - const cssLocal = ''
    link(href=`${cssBase}25_english-lp-main-2026.css?v=${Date.now()}`, rel="stylesheet")
    link(href=`${cssLocal}25_english-lp-main-2026.css?v=${Date.now()}`, rel="stylesheet")
