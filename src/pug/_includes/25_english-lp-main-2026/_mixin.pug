mixin cta-fixed
    .englp-fixed-cta-wrap(style='display:none;')
      a(href=UrlCv, target='_blank').englp-fixed-cta-button
        .englp-fixed-cta-button-sub
          |無料期間中のみの受講もOK
        .englp-fixed-cta-button-free
          img(src=IcnCta)
        .englp-fixed-cta-button-text
          |受講申し込みはこちら
        .englp-fixed-cta-button-icn.
          <span class="material-symbols-outlined">keyboard_arrow_right </span>
 
mixin menu-links 
   ul
        li
          a(href="#") 
            |トップ
        li
          a(href="#solution") 
            |特徴
        li
          a(href="#price") 
            |料金
        li
          a(href="#teacher") 
            |講師紹介
        li
          a(href="#feature") 
            |他スクールとの違い
        li
          a(href="#voice") 
            |受講生の声
        li
          a(href="#schedule") 
            |スケジュール
        li
          a(href="#faq") 
            |よくある質問

mixin menu-modal
  .menu-modal(style='display:none;')
    .menu-modal-logo
      img(src=ImgHeadLogoSp)
    .menu-modal-navi
      +menu-links
    .menu-modal-close.modal-close
      i.fa-solid.fa-xmark
      span|閉じる

.modal-video
  .modal-video-wrapper
    .modal-video-wrapper-content
      div(style="padding:56.25% 0 0 0;position:relative;")
        iframe(frameborder="0" allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media" style="position:absolute;top:0;left:0;width:100%;height:100%").modal-video-iframe
    .modal-video-close
      |閉じる
.bg-modal(style='display:none;')
script(src="https://player.vimeo.com/api/player.js")