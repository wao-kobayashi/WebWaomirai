mixin section-cta
     section.englp-cta
            .englp-cta-title
              |ワオ未来塾・グローバル英語に興味がある方はコチラ！
            .englp-cta-subtitle
              .englp-cta-subtitle-track
                span TRY! TRY! TRY! TRY! TRY! TRY! TRY! TRY! TRY! TRY!&nbsp;
                span TRY! TRY! TRY! TRY! TRY! TRY! TRY! TRY! TRY! TRY!&nbsp;
            .englp-cta-content
               .englp-cta-content-box
                 .englp-cta-content-box-icn
                   img(src=IcnPrice01)
                 .englp-cta-content-box-title
                    |まずは初月無料で
                    br
                    |レッスンを体験してみる
                 a.englp-cta-content-box-btn.cta(href=UrlCv, target='_blank')
                    .englp-cta-content-box-btn-sub
                       |料期間中のみの受講もOK
                    .englp-cta-content-box-btn-main
                       |受講申し込みはこちら
                    .englp-cta-content-box-btn-arrow.
                        <span class="material-symbols-outlined">keyboard_arrow_right </span>          
               .englp-cta-content-box
                 .englp-cta-content-box-icn
                    img(src=IcnPrice04)
                 .englp-cta-content-box-title
                    |個別の無料説明会(30分)で
                    br
                    |お子様の英会話のお悩みを
                    br.spimage
                    |解決しませんか？
                 a.englp-cta-content-box-btn.consultation.js-line-trigger(href=UrlLine,target='_blank')
                    .englp-cta-content-box-btn-sub
                       |特別トレーニング動画もプレゼント
                    .englp-cta-content-box-btn-main
                       |LINEで無料相談をする
                    .englp-cta-content-box-btn-arrow.
                        <span class="material-symbols-outlined">keyboard_arrow_right </span>      
 
mixin cta-fixed
    .englp-fixed-cta-wrap(style='display:none;')
      a(href=UrlCv, target='_blank').englp-fixed-cta-button
        .englp-fixed-cta-button-sub
          |無料期間中のみの受講もOK
        .englp-fixed-cta-button-free
          img(src=IcnCta)
        .englp-fixed-cta-button-text
          |受講申し込みはこちら
        .englp-fixed-cta-button-icn.
          <span class="material-symbols-outlined">keyboard_arrow_right </span>
 
mixin menu-links 
   ul
        li
          a(href="#") 
            |トップ
        li
          a(href="#solution") 
            |特徴
        li
          a(href="#price") 
            |料金
        li
          a(href="#schedule") 
            |スケジュール
        li
          a(href="#teacher") 
            |講師紹介
        li
          a(href="#feature") 
            |他スクールとの違い
        li
          a(href="#voice") 
