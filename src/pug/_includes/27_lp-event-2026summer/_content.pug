//mixin
include _mixin  
//variable
include _variables 
//data
include _data_seminar

doctype html
html
  head
    meta(charset="utf-8")
    script.
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-W3X8CG9C');
    // End Google Tag Manager
    meta(http-equiv="Content-Type", content="text/html; charset=utf-8")
    meta(name="viewport", content="width=device-width,initial-scale=1")
    link(href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css", rel="stylesheet")
    link(href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined", rel="stylesheet")
    - const cssBase = loycus ? '../../../css/' : '../../css/'
    - const cssLocal = loycus ? '../' : ''

    link(href=`${cssBase}27_lp-event-2026summer.css?v=${Date.now()}`, rel="stylesheet")
    link(href=`${cssLocal}27_lp-event-2026summer.css?v=${Date.now()}`, rel="stylesheet")

    meta(property="og:image", content=ImgOgp)
    title #{MetaTitle}
    script(src="https://waomirai.com/lp/assets/commonjs/jquery_3.7.1.js")
    script(src="https://waomirai.com/lp/assets/commonjs/qrcode.min.js")
    script(src="https://waomirai.com/lp/assets/commonjs/jquery.inview.min.js")
  body
    .pc-left.pcimage
       img(src='https://waomirai.com/lp/assets/commonimages/logo.svg')
    .pc-right.pcimage
     .pc-right-content
        .pc-right-content-cta
          +btn-cta 
    .main-content
        header
          img(src=ImgHeader)
        .summer-event-wrapper
          nav 
            li
              a(href="#science")|カラフルマジック 7/29(水)
            li
              a(href="#economy")|たこ焼き屋台 7/30(木)
          .summer-event#science 
              .summer-event-head 
                img(src=ImgHeadSc)
              .summer-event-info
                .summer-event-info-time-top 
                   .summer-event-info-time-top-date 
                      |2026.07.29
                   .summer-event-info-time-top-weekday  
                      |水
                .summer-event-info-grid      
                  .summer-event-info-grid-icon.  
                     <span class="material-symbols-outlined">schedule</span>
                  .summer-event-info-grid-text 
                     b|19:30-20:15   
                .summer-event-info-grid 
                  .summer-event-info-grid-icon.  
                     <span class="material-symbols-outlined">account_circle</span>
                  .summer-event-info-grid-text 
                    |小１〜６年生 （保護者様もぜひ！）   
                  .summer-event-info-grid-icon.  
                    <span class="material-symbols-outlined">
                    location_on
                    </span>
                  .summer-event-info-grid-text 
                    |オンライン(zoom)
                  .summer-event-info-grid-icon.  
                      <span class="material-symbols-outlined">
                      currency_yen
                      </span>
                  .summer-event-info-grid-text 
                    |無料   
              .summer-event-text
                |科学の魔法使いになろう！
                br
                br
                |目の前で水の色が次々と変わる！？
                br
                |不思議な実験室へようこそ！
                br
                br
                |身の回りの「なぜ？」を解き明かす、
                br
                |ワクワクの45分。どんな色が飛び出すかは、当日のお楽しみ！
                br
                br
                |おうちでもできる、カラフルで楽しい科学の世界へ飛び込もう！
                span|※授業終了後に保護者さま向けの説明会を開催致します。
              .summer-event-teacher 
                .summer-event-teacher-top 
                  .summer-event-teacher-top-left 
                    .summer-event-teacher-top-left-img 
                      img(src=ImgScTeacher)
                  .summer-event-teacher-top-right 
                    .summer-event-teacher-top-right-job|担当講師
                    .summer-event-teacher-top-right-name|犬飼 紀香
                .summer-event-teacher-text 
                  |身の回りのふしぎから最新の科学まで、さまざまな疑問を解き明かしていきましょう。
              .summer-event-cta        
                 +btn-cta  
          .summer-event#economy 
              .summer-event-head 
              .summer-event-info
              .summer-event-text
                |キミだけのたこ焼き屋台を作ってみよう！
                br
                |どんな名前にする？
                br
                br
                |材料はどうする？
                br
                br
                |どこで屋台を出して、いくらで売る？
                br
                br
                |「あ、となりにライバルのたこ焼き屋台ができちゃった...」たこ焼きの売り方を考えながら、アイデアを実現することや、工夫することの楽しさ、値段の仕組みを学びましょう！
                span|※授業終了後に保護者さま向けの説明会を開催致します。
              .summer-event-teacher 
                .summer-event-teacher-top 
                  .summer-event-teacher-top-left 
                    .summer-event-teacher-top-left-img 
                      img(src=ImgEcTeacher)
                  .summer-event-teacher-top-right 
                    .summer-event-teacher-top-right-job|担当講師
                    .summer-event-teacher-top-right-name|河原 大和
                .summer-event-teacher-text 
                  |「お金」について知ることは、必ずみんなのためになります。楽しみつつ一緒に学びましょう！
              .summer-event-cta        
                 +btn-cta  
        //かんたん5STEP
        section.join-5steps 
            .join-5steps-title 
              |かんたん5STEPで
              br
              |参加可能
            //step1
            .join-5steps-box
                .join-5steps-box-head 
                  .join-5steps-box-head-step
                      |STEP 
                      span|1
                  .join-5steps-box-head-img
                      img(src=ImgIcnStep01)
                .join-5steps-box-title 
                      |LINEで公式アカウントを
                      br
                      |友だち追加
                .join-5steps-box-text 
                      span.spimage|まず公式アカウントを友だちに追加してください。
                      span.pcimage|まず、二次元コードからスマートフォンで公式アカウントを友だちに追加してください。
                      //- |・LINEが利用できない場合はこちらから
                      |・友だち追加は
                      +conditionalLink
                        |こちら
                      |から

            //step2
            .join-5steps-box
                .join-5steps-box-head 
                  .join-5steps-box-head-step
                      |STEP 
                      span|2
                  .join-5steps-box-head-img
                       img(src=ImgIcnStep02)
                .join-5steps-box-title 
                      |友だち登録後、LINEのトーク
                      br
                      |画面に送られる申し込み
                      br
                      |フォームをタップ！
            
            //step3
            .join-5steps-box
                .join-5steps-box-head 
                  .join-5steps-box-head-step
                      |STEP 
                      span|3
                  .join-5steps-box-head-img
                       img(src=ImgIcnStep03)
                .join-5steps-box-title 
                  |Zoomをインストール
                .join-5steps-box-text 
                  |お手持ちの端末にzoomのインストールをお願いします。パソコンまたはタブレットが推奨です
            //step4
            .join-5steps-box
                .join-5steps-box-head 
                  .join-5steps-box-head-step
                      |STEP 
                      span|4
                  .join-5steps-box-head-img.step4
                     img(src=ImgIcnStep04)
                .join-5steps-box-title 
                      |イベント前日に
                      br
                      |LINEメッセージで
                      br
                      |イベントURLをお送りします
            //step5
            .join-5steps-box
                .join-5steps-box-head 
                  .join-5steps-box-head-step
                      |STEP 
                      span|5
                  .join-5steps-box-head-img
                     img(src=ImgIcnStep05)
                .join-5steps-box-title 
                      |開催時間になったら
                      br
                      |届いたイベントURLから
                      br
                      |参加しましょう！

        //footer
        footer 
          ul 
            li 
              a(href="https://www.wao-corp.com/", target='_blank')
                |会社概要
            li 
              a(href="https://www.wao-corp.com/kojin/", target='_blank')
                |プライバシーポリシー
            li
              a(href="https://waomirai.com/commerce_law/", target='_blank')
                |特定商取引に基づく表記
          .footer-logo 
            img(src='https://waomirai.com/lp/assets/commonimages/logo_white.svg')
          .footer-copyright
            |© ワオ・コーポレーション All rights reserved.

  
